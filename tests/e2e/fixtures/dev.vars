# Committed fixture for the end-to-end suite.
#
# This exists so a fresh clone (and CI) can run `npm run test:e2e` with no
# manual setup. `npm run test:e2e` copies it to `.dev.vars` ONLY when that file
# is missing, so a developer's own `.dev.vars` is never overwritten.
#
# These values are throwaway: the suite runs against its own local D1/R2 state
# (see playwright.config.ts) and never talks to a real deployment.
APP_URL=http://localhost:4173
APP_NAME=SocialSent

# Deliberately fake (64 hex chars / 32+ chars), and listed in the placeholder
# guard inside src/lib/server/env.ts.
APP_ENCRYPTION_KEY=deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef
AUTH_SECRET=deadbeefdeadbeefdeadbeefdeadbeefdeadbeef

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Several specs sign in with a password only, so the run skips 2FA enrollment.
# Honored only for a localhost APP_URL in a non-production build.
SKIP_TOTP=1
