{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "socialsent",
	"compatibility_date": "2026-08-17",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// This config is the generic one that ships with the repo. If you deploy a
	// personal instance, put your own Worker name, D1 database_id and R2 bucket
	// in `wrangler.personal.jsonc` (gitignored) and every npm script will pick
	// it up automatically — see scripts/wrangler.mjs.
	//
	// No crons here: the Workers free plan cannot hold a per-minute schedule.
	// Point an external pinger or the GitHub Actions workflow at
	// /api/internal/tick instead. To use a Cloudflare cron trigger instead
	// (paid plan), add one under "triggers" and set ENABLE_CF_CRON=1 in the
	// "vars" below — scripts/wrap-worker.mjs no-ops the scheduled handler
	// without it, so a leftover trigger cannot run the tick twice.
	//
	// Optional: binding a queue makes the tick hand publishes to a consumer
	// instead of publishing inline (one publish per message, with retries).
	// Add a "queues" block with a producer named PUBLISH_QUEUE and a consumer
	// for the same queue; src/hooks.server.ts picks the binding up automatically.
	"workers_dev": true,
	"preview_urls": false,
	"observability": { "enabled": true },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "socialsent",
			// Empty on purpose: it tells Wrangler (and the "Deploy to Cloudflare"
			// button) to create the database and bind it. Any value here — even a
			// placeholder string — is read as "this database already exists", and
			// provisioning is skipped. Your own deployment sets the real id in
			// wrangler.personal.jsonc, or you can leave it empty and let Wrangler
			// create it on first deploy.
			"database_id": "",
			"migrations_dir": "drizzle"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA"
			// No bucket_name on purpose: Wrangler derives one from the Worker name
			// and provisions it (an empty string is a config error, not "unset").
			// Your own deployment names its bucket in wrangler.personal.jsonc.
		}
	],
	// Non-secret vars only. Keys, passwords and OAuth client secrets belong in
	// Worker secrets (`npm run secrets:put`), because a deploy overwrites vars
	// with whatever this file says.
	"vars": {
		"APP_NAME": "SocialSent"
	}
}
