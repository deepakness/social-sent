{
	"name": "socialsent",
	"private": true,
	"version": "0.0.1",
	"description": "Minimal social scheduler for Mastodon, Bluesky, LinkedIn, Threads, and X. SvelteKit on Cloudflare Workers, D1, and R2.",
	"license": "MIT",
	"author": "DeepakNess <me@deepakness.com> (https://github.com/deepakness)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/deepakness/social-sent.git"
	},
	"homepage": "https://github.com/deepakness/social-sent#readme",
	"bugs": {
		"url": "https://github.com/deepakness/social-sent/issues"
	},
	"keywords": [
		"social-media",
		"scheduler",
		"mastodon",
		"bluesky",
		"linkedin",
		"threads",
		"sveltekit",
		"cloudflare-workers"
	],
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/wrap-worker.mjs",
		"preview": "node scripts/wrangler.mjs dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "vitest run",
		"test:e2e": "node scripts/e2e-prepare.mjs && playwright test",
		"deploy": "node scripts/deploy.mjs",
		"deploy:worker": "npm test && npm run build && node scripts/wrangler.mjs deploy",
		"secrets:put": "node scripts/put-secrets.mjs",
		"db:migrate:local": "node scripts/wrangler.mjs d1 migrations apply DB --local",
		"db:migrate:remote": "node scripts/wrangler.mjs d1 migrations apply DB --remote"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.11",
		"wrangler": "^4.131.2"
	},
	"dependencies": {
		"@libsql/client": "^0.17.4",
		"@lucide/svelte": "^1.42.0",
		"date-fns": "^4.4.0",
		"drizzle-orm": "^0.45.2",
		"uqr": "^0.1.3",
		"zod": "^4.4.3"
	},
	"allowScripts": {
		"esbuild@0.28.1": true,
		"fsevents@2.3.2": true,
		"fsevents@2.3.3": true,
		"workerd@1.20260911.1": true
	}
}
